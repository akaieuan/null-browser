{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IPC for the privileged shell webview only. Scoped to `webviews: [\"main\"]` (NOT `windows`): a windows-scoped grant reaches every webview of the window, including the `tab-*`/`popup-*` children that host hostile page content. The `allow-*` app-command grants below must stay in lockstep with build.rs and src/lib.rs — see docs/SECURITY.md.",
  "local": true,
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "allow-get-app-version",
    "allow-open-tab",
    "allow-activate-tabs",
    "allow-set-tab-corner-radius",
    "allow-set-tab-zoom",
    "allow-find-in-page",
    "allow-open-tab-devtools",
    "allow-close-tab",
    "allow-activate-tab",
    "allow-hide-all-tabs",
    "allow-navigate-tab",
    "allow-resize-content",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-clear-tab-storage",
    "allow-focus-shell",
    "allow-list-bookmarks",
    "allow-add-bookmark",
    "allow-remove-bookmark",
    "allow-update-bookmark",
    "allow-reorder-bookmarks",
    "allow-show-bookmark-menu",
    "allow-list-history",
    "allow-add-history",
    "allow-remove-history",
    "allow-clear-history",
    "allow-list-network-events",
    "allow-list-tracker-sightings",
    "allow-clear-network-events",
    "allow-set-network-paused",
    "allow-network-is-paused",
    "allow-block-origin",
    "allow-unblock-origin",
    "allow-list-blocked-origins",
    "allow-ad-blocking-enabled",
    "allow-set-ad-blocking",
    "allow-list-artifacts",
    "allow-get-artifact",
    "allow-delete-artifact",
    "allow-save-current-tab",
    "allow-clip-selection",
    "allow-get-notes-dir",
    "allow-create-note",
    "allow-update-note",
    "allow-get-favicons",
    "allow-group-bookmarks",
    "allow-create-folder",
    "allow-move-bookmark",
    "allow-set-window-theme",
    "allow-set-glass-material",
    "allow-search-get-instance",
    "allow-search-set-instance",
    "allow-search-clear-instance",
    "allow-search-web"
  ]
}
